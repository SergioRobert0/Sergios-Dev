{
  "name": "sergios-dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win portable"
  },
  "main": "desktop/main.cjs",
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.sergioloyola.portfolio",
    "productName": "Sergios-Dev",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "portfolio"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "app/favicon.ico",
      "artifactName": "Portfolio-Sergio-Loyola.exe"
    }
  }
}
